{
  "name": "nozey",
  "version": "0.2.0",
  "description": "The cozy virtual scrapbook",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "author": "Chris",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.nozey.app",
    "productName": "Nozey",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": "dmg"
    },
    "dmg": {
      "title": "Nozey",
      "iconSize": 80,
      "contents": [
        {
          "x": 170,
          "y": 200
        },
        {
          "x": 430,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "index.html",
      "Welcome Darling.otf"
    ]
  },
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
